# Copy to .env and fill in to hit real services. Leave any of these unset
# (or copy this file as-is) and that step of the pipeline runs in mock mode.
# .env is gitignored at the repo root — never commit real values.

PORT=3000

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Contacts

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DIALOG360_API_KEY=
DIALOG360_BASE_URL=https://waba-v2.360dialog.io
